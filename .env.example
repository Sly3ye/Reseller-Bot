# Variabili per docker-compose (copia in .env). I segreti dell'app (proxy,
# Telegram) stanno invece in backend/.env — vedi backend/.env.example.

# Password del Postgres in container (usala forte in produzione).
POSTGRES_PASSWORD=postgres

# URL pubblico da cui il browser carica le immagini servite dal backend.
# In locale va bene http://localhost:8000; sul VPS metti il dominio/IP pubblico.
PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# Origini frontend ammesse (CORS). In produzione aggiungi il dominio del frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
