# Copia in backend/.env e compila con i valori reali.

# --- Database (PostgreSQL self-hosted) ---
# In locale senza Docker: postgresql://postgres:postgres@localhost:5432/reseller
# Con docker-compose questa variabile è impostata dal compose (host = "db"),
# quindi qui puoi lasciarla vuota/commentata.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reseller

# --- Storage immagini (filesystem) ---
# MEDIA_ROOT: dove salvare i file (default ./media). Con Docker è /data/media.
# PUBLIC_MEDIA_BASE_URL: da dove il browser carica le immagini. In produzione
# metti il dominio/IP pubblico del VPS (es. https://tuo-vps.example).
# MEDIA_ROOT=./media
# PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# --- Ritmo di scraping (connessione diretta, nessun proxy a pagamento) ---
# Pausa minima tra due chiamate a hades.subito.it, condivisa da tutti i job.
# Misura il limite della tua macchina con: python scripts/probe_rate_limit.py --ramp
# SCRAPER_MIN_GAP_S=6
# Tetto della pausa dopo blocchi ripetuti, e pausa iniziale su 403/429 (raddoppia).
# SCRAPER_MAX_GAP_S=120
# SCRAPER_BLOCK_COOLDOWN_S=900
# Cadenza dei giri Sniper in minuti (default 15 tech / 30 auto).
# SNIPER_TECH_INTERVAL_MIN=15
# SNIPER_AUTO_INTERVAL_MIN=30

# --- Proxy HTTP (opzionale, sconsigliato) ---
# Il progetto non usa servizi a pagamento: lascia vuoto (= connessione diretta).
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Telegram alerts ---
# Bot creato con @BotFather. Due chat separate: una per il verticale tech
# (iPhone) e una per il verticale auto. Lascia vuoto per disattivare.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_TECH=
TELEGRAM_CHAT_ID_AUTO=
# Chat per gli alert di SISTEMA (scraper down/ripristino). Se vuoto, ripiega
# sulle chat dei verticali.
TELEGRAM_CHAT_ID_OPS=
# Pool di impronte browser (curl_cffi) separate da virgola: lo scraper ne usa
# una a caso per target (resilienza ad Akamai). Default: safari,firefox
# SCRAPER_IMPERSONATE=safari,firefox
# Soglia margine % per notificare una nuova opportunità (default 20).
# ALERT_MIN_MARGIN_PCT=20
# Calo prezzo % minimo per notificare un ribasso (default 10).
# ALERT_MIN_DROP_PCT=10

# --- Opzionali ---
# ENVIRONMENT=development
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI locale (Ollama sull'host, gratis) ---
# Analizza tutti gli iPhone attivi: guasti per tipo, parti non originali,
# motivo del prezzo, rischio, memoria/colore/batteria. Modello scelto con
# scripts/eval_guasti.py (vedi docs/RELEASE.md, B5). Prima: ollama pull <modello>.
# AI_ENABLED=true
# OLLAMA_MODEL=gemma4:e4b
# Guasti dell'AI che contano nella condizione (vuoto = default misurato):
# AI_TRUSTED_GUASTI=face-id,fotocamera,audio,tasti,scheda-madre,acqua,non-si-accende,bloccato,parti-non-originali,per-ricambi
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_NUM_CTX=4096
# Ritmo: ogni AI_INTERVAL_MIN minuti lavora al massimo AI_RUN_SECONDS, con
# AI_PAUSE_S di pausa tra due annunci (Mac non sempre a pieno carico).
# AI_INTERVAL_MIN=5
# AI_RUN_SECONDS=240
# AI_PAUSE_S=1.0
